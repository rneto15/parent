meta {
  name: Get document
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/dataentities/{{acronym}}/documents/{{document_id}}?_fields=_all
  body: none
  auth: none
}

params:query {
  _fields: _all
}

headers {
  X-VTEX-API-AppKey: {{appKey}}
  X-VTEX-API-AppToken: {{appToken}}
  Content-Type: application/json
  Accept: application/json
}
