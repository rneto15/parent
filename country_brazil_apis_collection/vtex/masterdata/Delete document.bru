meta {
  name: Delete document
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/dataentities/{{acronym}}/documents/{{document_id}}
  body: none
  auth: none
}

headers {
  X-VTEX-API-AppKey: {{appKey}}
  X-VTEX-API-AppToken: {{appToken}}
  Content-Type: application/json
  Accept: application/json
}
