meta {
  name: search
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/dataentities/{{acronym}}/search?_fields=_all&_size=10&_sort=createdIn DESC&_where=(createdIn>'2024-10-20T00:00' AND PriceModified="False")
  body: none
  auth: none
}

params:query {
  _fields: _all
  _size: 10
  _sort: createdIn DESC
  _where: (createdIn>'2024-10-20T00:00' AND PriceModified="False")
  ~_where: PriceModified="True"
  ~_where%3DPriceModified%20is%20True: 
}

headers {
  Accept: application/vnd.vtex.ds.v10+json
  Content-Type: application/json
  X-VTEX-API-AppKey: {{appKey}}
  X-VTEX-API-AppToken: {{appToken}}
  ~REST-Range: resources=37-40
}
