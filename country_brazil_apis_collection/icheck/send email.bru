meta {
  name: send email
  type: http
  seq: 3
}

post {
  url: {{endpoint}}/transactional/v1/communication/
  body: json
  auth: oauth2
}

headers {
  accept: application/json
  Content-Type: application/json
  x-api-key: {{x-api-key}}
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{endpoint_fedid}}
  refresh_token_url: 
  client_id: {{client_id_fedid}}
  client_secret: {{client_secret_fedid}}
  scope: 
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

body:json {
  {
      "attributes": {
          "CASHBACK_MESSAGE": "{{CASHBACK_MESSAGE}}",
          "FIRSTNAME": "{{FIRSTNAME}}"
      },
      "communicationChannel": "email",
      "communicationValue": {
          "emailAddress": "{{EMAIL}}"
      },
      "contactId": "{{MEMBER_ID}}",
      "countryCode": "BR",
      "eventCode": "CASHBACK",
      "languageCode": "pt"
  }
  
}
