meta {
  name: Consultar Lojas
  type: http
  seq: 1
}

get {
  url: http://decathlonmarketplace.conectala.com.br/app/Api/V1/Stores
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  accept: application/json;charset=UTF-8
  x-email: {{x-email}}
  x-api-key: {{x-api-key}}
  x-provider-key: {{x-provider-key}}
}

docs {
  <h3>Endpoint destinado para requisições realizadas por fornecedores.</h3>
  
  Consulta todas as lojas cadastradas por um fornecedor.
  
  Em caso de sucesso, a chave "success" é retornada com valor "true" e a chave "result" é retornada com as informações das lojas cadastradas.
  
  **Filtros:**
  
  *   ?store_id={id}
  *   ?store_anme={store_name}
  *   ?company_name={company_name}
  *   ?cnpj={cnpj}
}
