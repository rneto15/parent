meta {
  name: Atualizar Usuários
  type: http
  seq: 3
}

put {
  url: http://teste.conectala.com.br/app/Api/V1/Users/{{ID}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  accept: application/json;charset=UTF-8
  x-email: {{x-user-email}}
  x-api-key: {{x-api-key}}
  x-provider-key: {{x-store-key}}
}

body:json {
  {
      "user": {
          "username": "Nome do usuário",
          "email": "emailinventadoil@email.com.br",
          "group_name": "Parceiro",
          "firstname": "Nome",
          "lastname": "Sobrenome",
          "phone": "2133333333",
          "legal_administrator": "0",
          "cpf": ""
      }
  }
}

docs {
  <h3>Endpoint destinado para requisições realizadas por fornecedores.</h3>
  
  Atualiza o cadastro de um usuário de um fornecedor.
  
  **Não é possível atualizar a loja ou empresa do usuário**
  
  Em caso de sucesso, a chave "success" é retornada com valor "true" e a chave "result" é retornada com o valor "Updated data".
}
