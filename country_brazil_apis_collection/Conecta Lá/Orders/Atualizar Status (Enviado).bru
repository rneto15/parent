meta {
  name: Atualizar Status (Enviado)
  type: http
  seq: 8
}

put {
  url: http://teste.conectala.com.br/app/Api/V1/Orders/{{Order}}/shipped
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  accept: application/json;charset=UTF-8
  x-user-email: {{x-user-email}}
  x-api-key: {{x-api-key}}
  x-store-key: {{x-store-key}}
}

body:json {
  {
      "shipment": {
          "shipped_date": "2020-01-16 09:39:23"
      }
  }
}

docs {
  Atualiza o status do pedido para "<b>Em transporte</b>".
  
  O pedido <b>deve</b> ter o status <b>43</b> (Aguardando coleta/envio) para enviar.
  
  Em caso de sucesso, um resultado com duas chaves é retornado. A primeira chave, intitulada "success", tem o valor "true". A segunda chave, intitulada "message", tem "Order successfully updated" como valor.
}
