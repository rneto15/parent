meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/gdc/account/login
  body: json
  auth: none
}

headers {
  User-Agent: Decathlon
}

body:json {
  {
      "postUserLogin":{
          "login":"{{email}}",
          "password":"{{password}}",
          "remember":1
      }
  }
}

script:post-response {
  // var cookie = pm.getResponseCookie("GDCAuthTT")
  bru.setEnvVar("CookieTT", cookie);
}
