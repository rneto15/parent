meta {
  name: tradeback
  seq: 1
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{endpoint_oauth}}
  refresh_token_url: 
  client_id: {{client_id}}
  client_secret: {{client_secret}}
  scope: {{scope}}
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

docs {
  [https://wiki.decathlon.net/pages/viewpage.action?spaceKey=BRAZ&title=Cashback#Cashback-DadosCashback](https://wiki.decathlon.net/pages/viewpage.action?spaceKey=BRAZ&title=Cashback#Cashback-DadosCashback)
}
