meta {
  name: Criar Pedido - Com frete
  type: http
  seq: 2
}

post {
  url: http://sandbox-api.anymarket.com.br/v2/orders
  body: json
  auth: bearer
}

headers {
  gumgaToken: {{gumgaToken}}
  Content-Type: application/json
}

auth:bearer {
  token: gumgaToken={{token}}
}

