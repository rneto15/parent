meta {
  name: PUT - Pago
  type: http
  seq: 5
}

put {
  url: http://sandbox-api.anymarket.com.br/v2/orders/{{ID_ORDER}}
  body: json
  auth: bearer
}

headers {
  gumgaToken: {{gumgaToken}}
  Content-Type: application/json
}

auth:bearer {
  token: gumgaToken={{token}}
}

body:json {
  {
    "order_id": "ID_PEDIDO",
    "status": "PAID_WAITING_SHIP"
  }
}
