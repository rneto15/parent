meta {
  name: POST
  type: http
  seq: 3
}

post {
  url: http://sandbox-api.anymarket.com.br/v2/brands
  body: json
  auth: bearer
}

headers {
  gumgaToken: {{gumgaToken}}
  Content-Type: application/json
}

auth:bearer {
  token: gumgaToken={{token}}
}

body:json {
  {
    "name": "Marca Legal {{$randomInt}}",
    "partnerId":"{{$randomInt}}"
  }
  
}

script:post-response {
  test("Status code is 200", function() {
    expect(Boolean(responseCode.code === 200)).to.be.true;
  });
}
