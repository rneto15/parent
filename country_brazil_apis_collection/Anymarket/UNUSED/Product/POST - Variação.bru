meta {
  name: POST - Variação
  type: http
  seq: 4
}

post {
  url: http://sandbox-api.anymarket.com.br/v2/products
  body: json
  auth: bearer
}

headers {
  gumgaToken: {{gumgaToken}}
  Content-Type: application/json
}

auth:bearer {
  token: gumgaToken={{token}}
}

