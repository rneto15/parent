meta {
  name: Listar chamados por trans id v2
  type: http
  seq: 4
}

get {
  url: {{endpoint}}/api/MILLENIUM_ECO!DECATHLON/CHAMADOS/LISTA_V2?$format=json&$dateformat=ISO&trans_id={{trans_id}}&$top=20
  body: none
  auth: basic
}

params:query {
  $format: json
  $dateformat: ISO
  trans_id: {{trans_id}}
  $top: 20
  ~datai: 2022-08-22-16-56-00
  ~dataf: 2022-08-22-23-56-00
}

auth:basic {
  username: {{username}}
  password: {{password}}
}
