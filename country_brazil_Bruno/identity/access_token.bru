meta {
  name: access_token
  type: http
  seq: 1
}

post {
  url: {{endpoint_fedid}}
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{client_id_fedid}}
  password: {{client_secret_fedid}}
}

body:form-urlencoded {
  grant_type: client_credentials
}

script:pre-request {
  var jsonData = JSON.parse(responseBody);
  bru.setEnvVar("access_token", jsonData.access_token);
}
