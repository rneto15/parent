meta {
  name: POST - Sem Variação
  type: http
  seq: 3
}

post {
  url: http://sandbox-api.anymarket.com.br/v2/products
  body: json
  auth: bearer
}

headers {
  gumgaToken: {{gumgaToken}}
  Content-Type: application/json
}

auth:bearer {
  token: gumgaToken={{token}}
}

