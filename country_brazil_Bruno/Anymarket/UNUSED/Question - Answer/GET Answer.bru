meta {
  name: GET Answer
  type: http
  seq: 2
}

get {
  url: http://sandbox-api.anymarket.com.br/v2/questions/{{ID_PERGUNTA}}/answers/{{ID_RESPOSTA}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
  gumgaToken: {{gumgaToken}}
  gumgaOI: {{gumgaOI}}
}

auth:bearer {
  token: gumgaToken={{token}}
}
