meta {
  name: POST Answer
  type: http
  seq: 3
}

post {
  url: http://sandbox-api.anymarket.com.br/v2/questions/{{ID_PERGUNTA}}/answers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  gumgaToken: {{gumgaToken}}
  gumgaOI: {{gumgaOI}}
}

auth:bearer {
  token: gumgaToken={{token}}
}

body:json {
  {
      "answer":"Cabra bão você hein"
  }
}
