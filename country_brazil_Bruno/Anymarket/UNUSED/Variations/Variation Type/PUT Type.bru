  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  gumgaToken: {{gumgaToken}}
  gumgaOI: {{gumgaOI}}
}

auth:bearer {
  token: gumgaToken={{token}}
}

body:json {
  {
    "name": "Variation (8) Test",
    "visualVariation": "true",
    "partnerId": "OWN-VARIATION"
  }
}
