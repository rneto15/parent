meta {
  name: POST
  type: http
  seq: 3
}

post {
  url: http://sandbox-api.anymarket.com.br/v2/products/{{ID_PRODUCT}}/images
  body: json
  auth: bearer
}

headers {
  gumgaToken: {{gumgaToken}}
  Content-Type: application/json
}

auth:bearer {
  token: gumgaToken={{token}}
}

body:json {
  {
    "url":"http://www.example.com.br/example.jpg"
  }
  
}
