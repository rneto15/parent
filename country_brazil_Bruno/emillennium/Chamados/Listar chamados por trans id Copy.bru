meta {
  name: Listar chamados por trans id Copy
  type: http
  seq: 3
}

get {
  url: {{endpoint}}/api/millenium_eco!decathlon/chamados/lista?$format=json&$dateformat=ISO&$top=1&trans_id={{trans_id}}
  body: none
  auth: basic
}

params:query {
  $format: json
  $dateformat: ISO
  $top: 1
  trans_id: {{trans_id}}
  ~datai: 2022-08-22-16-56-00
  ~dataf: 2022-08-22-23-56-00
}

auth:basic {
  username: {{username}}
  password: {{password}}
}
