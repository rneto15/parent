meta {
  name: balance
  type: http
  seq: 1
}

post {
  url: {{endpoint}}/broadcast/v2/Credit/balance?allowNegativeBalance=true
  body: json
  auth: oauth2
}

params:query {
  allowNegativeBalance: true
}

headers {
  Ocp-Apim-Subscription-Key: {{x-api-key}}
  Content-Type: application/json
  ~Authorization: Bearer <token>
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{endpoint_oauth}}
  refresh_token_url: 
  client_id: {{client_id}}
  client_secret: {{client_secret}}
  scope: {{scope}}
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

body:json {
  {
    "providerId": "{{wallet_id}}",
    "participantIdentifier": "{{cpf}}"
  }
}
