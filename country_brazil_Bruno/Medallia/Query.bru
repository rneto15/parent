meta {
  name: Query
  type: graphql
  seq: 2
}

post {
  url: https://decathlon.apis.medallia.com/data/v0/query
  body: graphql
  auth: bearer
}

headers {
  Authorization: Bearer 7ceb66e22636b49326c962a4949ba77
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:graphql {
  query survey_reponses(
      $start_date: String
      $end_date: String) {
      feedback(
          filter: {
          and: [
               # { fieldIds: "e_bp_digital_survey_alt", in: ["1013", "1014"] }
               # { fieldIds: "a_surveyid", in: ["31360877"] }
               { fieldIds: "k_decat_country_unified_alt", in: ["31"] } # Brazil
               { fieldIds: "k_decat_survey_type", in: ["1", "2"] } # Digital Post - Purchase, Digital Post - Delivery
               { fieldIds: "e_responsedate", gte: $start_date }
               { fieldIds: "e_responsedate", lt: $end_date }
          ]
      },
          first: 200,
        # after: "xcCgnbuGInewVTSRq4sfYhmAtRe8"
      ) {
          totalCount
          pageInfo { 
              hasNextPage
              endCursor
          }
          nodes {
              survey_id: fieldData(fieldId: "a_surveyid") {
                  values
              }
              survey_type: fieldData(fieldId: "k_decat_survey_type") {
                  values
              }
              digital_survey: fieldData(fieldId: "e_bp_digital_survey_alt") {
                  values
              }
              form_id: fieldData(fieldId: "e_bp_digital_form_id_txt") {
                  values
              }
              unique_record_id: fieldData(fieldId: "e_bp_uniquerecordid_txt") {
                  values
              }
              response_date: fieldData(fieldId: "e_responsedate") {
                  values
              }
              local_response_date: fieldData(fieldId: "k_bp_timezone_response_time") {
                  values
              }
              country: fieldData(fieldId: "k_decat_country_unified_alt") {
                  values
              }
              member_id: fieldData(fieldId: "e_decat_reg_number_text") {
                  values
              }
              user_member_id: fieldData(fieldId: "q_md_text_custom_parameter_field_5657") {
                  values
              }
              user_loyalit_card: fieldData(fieldId: "q_md_text_custom_parameter_field_5656") {
                  values
              }
              transaction_id: fieldData(fieldId: "e_decat_transaction_id_text") {
                  values
              }
              order_id: fieldData(fieldId: "q_md_text_custom_parameter_field_5648") {
                  values
              }
              transaction_type: fieldData(fieldId: "k_decat_transaction_type_pp_digital_alt") {
                  values
              }
              purchase_post_purchase_nps: fieldData(fieldId: "q_decat_purchase_online_ltr_scale11") {
                  values
              }
              purchase_post_purchase_reason_for_nps: fieldData(fieldId: "q_decat_purchase_online_ltr_reason_cmnt") {
                  values
              }
              purchase_easy_to_find: fieldData(fieldId: "q_decat_purchase_online_easy_to_find_scale5") {
                  values
              }
              purchase_easy_to_compare: fieldData(fieldId: "q_decat_purchase_online_easy_to_compare_scale5") {
                  values
              }
              purchase_easy_to_choose: fieldData(fieldId: "q_decat_purchase_online_easy_to_choose_scale5") {
                  values
              }
              purchase_product_variety: fieldData(fieldId: "q_decat_purchase_online_product_variety_scale5") {
                  values
              }
              purchase_product_availability: fieldData(fieldId: "q_decat_purchase_online_product_availability_scale5") {
                  values
              }
              purchase_ease_to_login: fieldData(fieldId: "q_decat_purchase_online_ease_to_login_scale5") {
                  values
              }
              purchase_ease_to_choose_delivery: fieldData(fieldId: "q_decat_purchase_online_ease_to_choose_delivery_scale5") {
                  values
              }
              purchase_delivery_issues: fieldData(fieldId: "q_decat_purchase_online_delivery_issues_alt") {
                  values
              }
              purchase_delivery_issues_other: fieldData(fieldId: "q_decat_purchase_online_delivery_issues_other_txt") {
                  values
              }
              purchase_easy_to_pay: fieldData(fieldId: "q_decat_purchase_online_easy_to_pay_scale5") {
                  values
              }
              purchase_payment_issues: fieldData(fieldId: "q_decat_purchase_online_alt") {
                  values
              }
              purchase_purchase_payment_issues_other: fieldData(fieldId: "q_decat_purchase_online_oyher_txt") {
                  values
              }
              purchase_additional_comments: fieldData(fieldId: "q_decat_purchase_online_additional_cmnt") {
                  values
              }
              delivery_number_selected: fieldData(fieldId: "e_decat_post_delivery_number_selected") {
                  values
              }
              delivery_method: fieldData(fieldId: "e_decat_delivery_method_alt") {
                  values
              }
              delivery_method_2: fieldData(fieldId: "e_decat_delivery_method_2_alt") {
                  values
              }
              delivery_method_3: fieldData(fieldId: "e_decat_delivery_method_3_alt") {
                  values
              }
              delivery_provider: fieldData(fieldId: "e_decat_del_partner_auto") {
                  values
              }
              delivery_provider_2: fieldData(fieldId: "e_decat_del_partner_2_auto") {
                  values
              }
              delivery_provider_3: fieldData(fieldId: "e_decat_del_partner_3_auto") {
                  values
              }
              delivery_id: fieldData(fieldId: "e_decat_delivery_id_text") {
                  values
              }
              delivery_nps: fieldData(fieldId: "q_decat_delivery_ltr_scale") {
                  values
              }
              delivery_reason_for_nps: fieldData(fieldId: "q_decat_delivery_ltr_reason_cmnt") {
                  values
              }
              delivery_order_status: fieldData(fieldId: "q_decat_delivery_order_status_scale5") {
                  values
              }
              delivery_speed: fieldData(fieldId: "q_decat_delivery_speed_scale5") {
                  values
              }
              delivery_polite: fieldData(fieldId: "q_decat_delivery_polite_scale5") {
                  values
              }
              delivery_package: fieldData(fieldId: "q_decat_delivery_package_scale5") {
                  values
              }
              delivery_reason_package: fieldData(fieldId: "q_decat_delivery_reason_package_cmnt") {
                  values
              }
              delivery_content: fieldData(fieldId: "q_decat_delivery_content_scale5") {
                  values
              }
              delivery_reason_content: fieldData(fieldId: "q_decat_delivery_reason_contact_enum") {
                  values
              }
              rdelivery_eason_content_other: fieldData(fieldId: "q_decat_delivery_reason_contact_other") {
                  values
              }
              delivery_easy: fieldData(fieldId: "q_decat_delivery_easy_scale5") {
                  values
              }
              delivery_waiting_time_at_front_desk: fieldData(fieldId: "q_decat_waiting_time_scale5") {
                  values
              }
              delivery_welcoming: fieldData(fieldId: "q_decat_delivery_welcoming_scale5") {
                  values
              }
              delivery_pick_up_method: fieldData(fieldId: "q_decat_delivery_pick_up_method_alt") {
                  values
              }
          }
      }
  }
}

body:graphql:vars {
  {
      "start_date" : "2024-05-28 00:00:00",
