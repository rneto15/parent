meta {
  name: Criar Loja
  type: http
  seq: 2
}

post {
  url: http://teste.conectala.com.br/app/Api/V1/Stores
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  accept: application/json;charset=UTF-8
  x-email: {{x-user-email}}
  x-api-key: {{x-api-key}}
  x-provider-key: {{x-store-key}}
}

