meta {
  name: create job
  type: http
  seq: 4
}

post {
  url: {{baseurl}}/createItem?name=PIPELINE_CRM
  body: xml
  auth: basic
}

params:query {
  name: PIPELINE_CRM
}

auth:basic {
  username: {{user}}
  password: {{token}}
}

body:xml {
  <flow-definition plugin="workflow-job@1360.vc6700e3136f5">
      <actions>
      <org.jenkinsci.plugins.pipeline.modeldefinition.actions.DeclarativeJobAction plugin="pipeline-model-definition@2.2131.vb_9788088fdb_5"/>
      <org.jenkinsci.plugins.pipeline.modeldefinition.actions.DeclarativeJobPropertyTrackerAction plugin="pipeline-model-definition@2.2131.vb_9788088fdb_5">
      <jobProperties/>
      <triggers/>
      <parameters/>
      <options/>
      </org.jenkinsci.plugins.pipeline.modeldefinition.actions.DeclarativeJobPropertyTrackerAction>
      </actions>
      <description>PROCEDURES CRM</description>
      <keepDependencies>false</keepDependencies>
      <properties>
      <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
      <daysToKeep>2</daysToKeep>
      <numToKeep>50</numToKeep>
      <artifactDaysToKeep>-1</artifactDaysToKeep>
      <artifactNumToKeep>-1</artifactNumToKeep>
      </strategy>
      </jenkins.model.BuildDiscarderProperty>
      <org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty>
      <abortPrevious>false</abortPrevious>
      </org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty>
      <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
      <hudson.model.StringParameterDefinition>
      <name>Local_files</name>
      <defaultValue>/data/files/prod/crm</defaultValue>
      <trim>false</trim>
      </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
      </hudson.model.ParametersDefinitionProperty>
      <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
      <hudson.triggers.TimerTrigger>
      <spec>25 7,14 * * *</spec>
      </hudson.triggers.TimerTrigger>
      </triggers>
      </org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      </properties>
      <definition class="org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition" plugin="workflow-cps@3659.v582dc37621d8">
      <script>pipeline { agent any stages { stage('time init') { steps { script { echo 'time init' HOUR = sh(returnStdout: true, script: 'date +"%H"').trim() DAY = sh(returnStdout: true, script: 'date +"%u"').trim() } } } stage('TODOS OS DIAS AS 7h') { steps { script { if (HOUR.toInteger() == 7) { stage('TODOS OS DIAS AS 7h') { echo 'stage 1' build job: 'GENERIC_RED_TO_RED_BDD_1_08092022_EXECUTE_PROCEDURE_JDF', parameters: [string(name: 'PIPELINE_FILE', value: '/data/pipeline_files/PIPELINE_CRM_1.csv'), string(name: 'Local_files', value: params.Local_files)] } } else { echo "TODOS OS DIAS AS 7h - Out of schedule " } } } } stage('TODOS OS DIAS AS 7h E 14h') { steps { script { if (HOUR.toInteger() == 7 || HOUR.toInteger() == 14) { stage('TODOS OS DIAS AS 7h E 14h') { echo 'stage 4' build job: 'GENERIC_RED_TO_RED_BDD_1_08092022_EXECUTE_PROCEDURE_JDF', parameters: [string(name: 'PIPELINE_FILE', value: '/data/pipeline_files/PIPELINE_CRM_4.csv'), string(name: 'Local_files', value: params.Local_files)] } } else { echo "TODOS OS DIAS AS 7h E 14h - Out of schedule " } } } } stage('TODAS AS SEGUNDA AS 7h') { steps { script { if (HOUR.toInteger() == 7 && DAY.toInteger() == 1) { stage('TODAS AS SEGUNDA AS 7h') { echo 'stage 2' build job: 'GENERIC_RED_TO_RED_BDD_1_08092022_EXECUTE_PROCEDURE_JDF', parameters: [string(name: 'PIPELINE_FILE', value: '/data/pipeline_files/PIPELINE_CRM_2.csv'), string(name: 'Local_files', value: params.Local_files)] } } else { echo "TODAS AS SEGUNDA AS 7h - Out of schedule " } } } } stage('TODAS AS SEGUNDA,QUARTA E SEXTA AS 7h') { steps { script { if (HOUR.toInteger() == 7 && (DAY.toInteger() == 1 || DAY.toInteger() == 3 || DAY.toInteger() == 5)) { stage('TODAS AS SEGUNDA,QUARTA E SEXTA AS 7h') { echo 'stage 3' build job: 'GENERIC_RED_TO_RED_BDD_1_08092022_EXECUTE_PROCEDURE_JDF', parameters: [string(name: 'PIPELINE_FILE', value: '/data/pipeline_files/PIPELINE_CRM_3.csv'), string(name: 'Local_files', value: params.Local_files)] } } else { echo "TODAS AS SEGUNDA,QUARTA E SEXTA AS 7h - Out of schedule " } } } } } } </script>
      <sandbox>true</sandbox>
      </definition>
      <triggers/>
      <disabled>false</disabled>
      </flow-definition>
}
