  				unstable {
  					script {
  						error "Unstable, exiting now..."
  					}
  				}
  			}
  		}
  		stage('refresh a_daily_kpi') {
  			steps {
  				echo 'stage 11'
  				build job: 'GENERIC_RED_TO_RED_BDD_1_08092022_EXECUTE_PROCEDURE_JDF', parameters: [string(name: 'PIPELINE_FILE', value: '/data/pipeline_files/PIPELINE_INTEGRIDADE_SAP_11.csv'), string(name: 'LOG_FILE', value: params.LOG_FILE), string(name: 'Local_files', value: params.Local_files)]
  			}
  		}
  	}
  }</script>
      <sandbox>true</sandbox>
    </definition>
    <triggers/>
    <disabled>false</disabled>
  </flow-definition>
}
