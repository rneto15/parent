meta {
  name: Update partial document
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/dataentities/:acronym/documents/:id
  body: json
  auth: apikey
}

params:path {
  acronym: SP
  id: SP-b818cbda-e489-11e6-94f4-0ac138d2d42e
}

headers {
  Content-Type: application/json
  Accept: application/vnd.vtex.ds.v10+json
  Content-Type: application/json
}

auth:apikey {
  key: X-VTEX-API-AppKey
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "addressName": "4726026151253"
  }
}

script:post-response {
  // Validate status 2xx 
