meta {
  name: send sms or email
  type: http
  seq: 2
}

post {
  url: {{endpoint}}/transactional/v1/communication/
  body: json
  auth: oauth2
}

headers {
  accept: application/json
  Content-Type: application/json
  x-api-key: {{x-api-key}}
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{endpoint_fedid}}
  refresh_token_url: 
  client_id: {{client_id_fedid}}
  client_secret: {{client_secret_fedid}}
  scope: 
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

body:json {
  {
    "contactId": "{{MEMBER_ID}}",
    "countryCode": "BR",
    "languageCode": "pt",
    "communicationChannel": "email or sms",
    "eventCode": "CASHBACK",
    "attributes": {
      "additionalProp1": "{{CASHBACK_MESSAGE}}"
    },
    "communicationValue": {
      "emailAddress": "{{email}}",
      "mobileNumber": {
        "value": "{{mobile_number}}",
        "countryCode": "BR"
      }
    },
    "smsMessage": {
      "text": "{{CASHBACK_MESSAGE}}"
    }
  }
}
