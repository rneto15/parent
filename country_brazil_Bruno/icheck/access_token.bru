meta {
  name: access_token
  type: http
  seq: 1
}

post {
  url: {{endpoint_fedid}}
  body: formUrlEncoded
  auth: basic
}

headers {
  Accept: application/json
}

auth:basic {
  username: {{client_id_fedid}}
  password: {{client_secret_fedid}}
}

body:form-urlencoded {
  grant_type: client_credentials
}
