meta {
  name: preview_email
  type: http
  seq: 4
}

post {
  url: {{endpoint}}/transactional/v1/communication/preview
  body: json
  auth: oauth2
}

headers {
  accept: application/json
  Content-Type: application/json
  x-api-key: {{x-api-key}}
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{endpoint_fedid}}
  refresh_token_url: 
  client_id: {{client_id_fedid}}
  client_secret: {{client_secret_fedid}}
  scope: 
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

body:json {
  {
    "contactId": "{{MEMBER_ID}}",
    "countryCode": "BR",
    "languageCode": "pt",
    "communicationChannel": "email",
    "eventCode": "CASHBACK",
    "attributes": {
      "CASHBACK_MESSAGE": "{{CASHBACK_MESSAGE}}",
      "FIRSTNAME":"{{FIRSTNAME}}"
    },
    "communicationValue": {
      "emailAddress": "{{EMAIL}}"
    }
  }
}
