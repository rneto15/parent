meta {
  name: Pagination : full example page 2
  type: http
  seq: 20
}

get {
  url: https://api-eu.preprod.subsidia.org/posdata_api/poslogs?sortBy=sequenceNumber&sortOrder=desc&from=5&size=5
  body: none
  auth: none
}

